{
    "name": "@tsmztech/mcp-server-salesforce",
    "version": "0.0.3",
    "description": "A Salesforce connector MCP Server with HTTP support for Cloudways deployment.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "bin": {
      "salesforce-connector": "dist/index.js",
      "salesforce-http-server": "dist/http-server.js"
    },
    "files": [
      "dist",
      "ecosystem.config.js",
      ".env.example"
    ],
    "scripts": {
      "build": "tsc && shx chmod +x dist/*.js",
      "prepare": "npm run build",
      "watch": "tsc --watch",
      "test": "node --test",
      "start": "node dist/http-server.js",
      "start:mcp": "node dist/index.js",
      "start:http": "node dist/http-server.js",
      "start:prod": "NODE_ENV=production node dist/http-server.js",
      "pm2:start": "pm2 start ecosystem.config.js",
      "pm2:stop": "pm2 stop ecosystem.config.js",
      "pm2:restart": "pm2 restart ecosystem.config.js",
      "pm2:delete": "pm2 delete ecosystem.config.js",
      "pm2:logs": "pm2 logs salesforce-mcp-server",
      "pm2:monit": "pm2 monit"
    },
    "keywords": [
      "mcp",
      "salesforce",
      "claude",
      "ai",
      "http",
      "api",
      "cloudways"
    ],
    "author": "tsmztech",
    "license": "MIT",
    "dependencies": {
      "@modelcontextprotocol/sdk": "1.17.4",
      "dotenv": "^17.2.1",
      "jsforce": "^3.10.3",
      "express": "^4.21.1",
      "cors": "^2.8.5"
    },
    "devDependencies": {
      "@types/node": "^24.3.0",
      "@types/express": "^4.17.21",
      "@types/cors": "^2.8.17",
      "typescript": "^5.7.2",
      "shx": "^0.4.0"
    }
  }
  