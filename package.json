{
    "name": "@tsmztech/mcp-server-salesforce",
    "version": "2.0.0",
    "description": "A dynamic multi-tenant Salesforce MCP Server for AI agents.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "bin": {
      "salesforce-connector": "dist/index.js"
    },
    "files": [
      "dist"
    ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "node --test",
    "serve": "node dist/http-server.js",
    "dev": "npm run build && npm run serve",
    "start": "npm run serve",
    "railway:build": "npm run build",
    "railway:start": "npm run serve"
  },
    "keywords": [
      "mcp",
      "salesforce",
      "ai-agent",
      "multi-tenant",
      "dynamic-credentials",
      "railway",
      "claude"
    ],
    "author": "tsmztech",
    "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.4",
    "dotenv": "^17.2.1",
    "jsforce": "^3.10.3",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "typescript": "^5.7.2",
    "shx": "^0.4.0"
  }
  }
  