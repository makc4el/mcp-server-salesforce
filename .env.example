# Salesforce MCP Server Configuration

# ======================
# HTTP Server Configuration
# ======================

# Server port (default: 3000)
PORT=3000

# API key for authentication (optional but recommended)
API_KEY=your-secret-api-key-here

# CORS allowed origins (comma-separated, * for all origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ======================
# Salesforce Authentication
# ======================

# Connection type: User_Password | OAuth_2.0_Client_Credentials | Salesforce_CLI
SALESFORCE_CONNECTION_TYPE=User_Password

# For Username/Password Authentication
SALESFORCE_USERNAME=your-salesforce-username
SALESFORCE_PASSWORD=your-salesforce-password
SALESFORCE_TOKEN=your-security-token
SALESFORCE_INSTANCE_URL=https://login.salesforce.com

# For OAuth 2.0 Client Credentials Flow
# SALESFORCE_CLIENT_ID=your-connected-app-client-id
# SALESFORCE_CLIENT_SECRET=your-connected-app-client-secret
# SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com

# For Salesforce CLI Authentication (no additional config needed)
# Make sure you're authenticated with 'sf org login' and have a default org set
