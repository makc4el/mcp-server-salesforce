# Salesforce AI Agent MCP Server Configuration
# This server operates in DYNAMIC-ONLY mode

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# HTTP server port
PORT=3000

# =============================================================================
# SECURITY (Optional but recommended for production)
# =============================================================================

# Optional: API key for HTTP server authentication
# API_KEY=your-secret-api-key

# Optional: CORS origins (comma-separated, default: *)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# SALESFORCE CREDENTIALS
# =============================================================================

# ⚠️  NO STATIC CREDENTIALS NEEDED! ⚠️
# AI agents provide credentials dynamically via headers:
# X-Salesforce-Credentials: {"instanceUrl":"https://org.my.salesforce.com","accessToken":"token"}

# =============================================================================
# QUICK START
# =============================================================================

# 1. Copy this file: cp example.env .env
# 2. Deploy to Railway: railway up
# 3. AI agents connect with dynamic credentials
# 4. No Salesforce configuration needed on server!
