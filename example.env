# Salesforce MCP Server Configuration

# Required: Salesforce Connected App credentials (static)
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key_here
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret_here

# OAuth redirect URI - must match Connected App configuration
SALESFORCE_REDIRECT_URI=https://prtctipgoioqpytelojf.supabase.co/functions/v1/callback

# Required: Your Salesforce access token (fallback only)
# Get from: sf org display --verbose (look for "Access Token")
# Or from OAuth 2.0 flow with your Connected App
SALESFORCE_ACCESS_TOKEN=your-access-token-here

# Optional: Refresh token for automatic token renewal
# SALESFORCE_REFRESH_TOKEN=your-refresh-token-here

# Optional: HTTP server port (default: 3000)
PORT=3000

# Optional: API key for HTTP server authentication
# API_KEY=your-secret-api-key

# Optional: CORS origins (comma-separated, default: *)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Quick start:
# 1. Copy this file: cp example.env .env
# 2. Update your Connected App credentials (Client ID, Client Secret, Redirect URI)
# 3. Run: npm run build && npm run serve
# 4. Send HTTP requests with X-Salesforce-Credentials header containing:
#    {"instanceUrl": "https://your-org.lightning.force.com/", "authCode": "aPrx.your_code..."}
# 
# Note: SALESFORCE_INSTANCE_URL and SALESFORCE_AUTH_CODE are now provided dynamically via HTTP requests only
