# Railway Deployment Environment Configuration
# Copy these variables to your Railway project environment settings

# ==========================================
# REQUIRED: Salesforce OAuth Configuration
# ==========================================
# Get these from your Salesforce Connected App
SALESFORCE_CLIENT_ID=your_connected_app_client_id_here
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret_here

# OAuth redirect URI (typically for local dev or your callback endpoint)
SALESFORCE_REDIRECT_URI=http://localhost:3000/callback

# ==========================================
# OPTIONAL: Security Configuration
# ==========================================
# API Key for additional security (recommended for production)
# API_KEY=your_secure_random_api_key_here

# ==========================================
# OPTIONAL: CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
# Leave empty or set to * for development, restrict for production
# ALLOWED_ORIGINS=https://smith.langchain.com,https://api.smith.langchain.com,https://your-custom-domain.com

# For LangChain Platform integration, include these domains:
# ALLOWED_ORIGINS=https://smith.langchain.com,https://api.smith.langchain.com

# ==========================================
# OPTIONAL: Application Configuration  
# ==========================================
# Environment mode
NODE_ENV=production

# Debug logging (set to true for debugging, false for production)
DEBUG=false

# ==========================================
# Railway Automatic Variables (do not set)
# ==========================================
# PORT - Railway sets this automatically
# RAILWAY_ENVIRONMENT - Railway sets this automatically
